# Environment container API Python — salin jadi .env.docker lalu isi (JANGAN di-commit).
#   cp .env.docker.example .env.docker

# Host/port di dalam container (jangan diubah — Dockerfile & compose memakai 8080).
API_HOST=0.0.0.0
API_PORT=8080

# ===== Database =====
# Host = NAMA CONTAINER Postgres di network data-net (bukan localhost!), mis. `postgres` /
# `treding-postgres`. Disarankan user read-only khusus (lihat docs/API_RUST.md / README).
# Karakter spesial di password harus di-URL-encode (@ -> %40, # -> %23).
DATABASE_URL=postgres://python_reader:ganti_password@postgres:5432/treding_rust
DB_CONNECT_TIMEOUT=5

# Kurs default Rp per 1 USDT untuk POST /signal (kalau Rust tidak mengirim kurs_usdt_idr).
USDT_IDR_RATE=16300

# ===== Keamanan =====
# WAJIB diisi di VPS. Backend Rust mengirim nilai yang sama di header X-API-Key.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Kosong = CORS mati (Rust memanggil server-ke-server, bukan browser).
CORS_ORIGINS=

# /docs & /openapi.json dimatikan di VPS.
ENABLE_DOCS=false
