# Konfigurasi API — salin file ini jadi .env lalu sesuaikan
# cp .env.example .env   (atau copy .env.example .env di Windows)

# Host tempat API listen. 0.0.0.0 = bisa diakses dari luar (backend Rust di mesin lain).
# 127.0.0.1 = hanya lokal.
API_HOST=0.0.0.0

# Port API. Ganti kalau 8080 sudah dipakai proses lain.
API_PORT=8080

# ===== Sumber data pihak ketiga (jarang perlu diubah) =====

# API Fear & Greed Index (sentimen pasar)
FNG_API_URL=https://api.alternative.me/fng/

# Arsip data OHLCV Binance Vision (untuk download histori coin)
BINANCE_VISION_URL=https://data.binance.vision/data/spot/monthly/klines

# ===== Database =====

# PostgreSQL tempat backtes-crypto konek (DB milik backend-treding-rust).
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DB
# Karakter spesial di password harus di-URL-encode (mis. @ -> %40, # -> %23).
DATABASE_URL=postgres://postgres:your_password@localhost:5432/treding_rust

# Batas waktu (detik) per percobaan koneksi DB. Opsional, default 5.
# DB_CONNECT_TIMEOUT=5

# Data pasar dari DB di-cache di memori, dimuat ulang tiap N detik. Opsional, default 3600.
# MARKET_CACHE_TTL=3600

# Kurs default Rp per 1 USDT untuk POST /signal (kalau Rust tidak mengirim kurs_usdt_idr).
# USDT_IDR_RATE=16300
